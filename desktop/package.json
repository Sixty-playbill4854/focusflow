{
  "name": "focusflow-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "FocusFlow desktop wrapper for Windows",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.focusflow.desktop",
    "productName": "FocusFlow",
    "directories": { "output": "release" },
    "files": ["main.cjs", "package.json"],
    "extraResources": [{ "from": "../dist", "to": "dist" }],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
